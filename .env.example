# FetchLy Environment Configuration
# Copy this file to .env and fill in your values

# ==================== BACKEND ====================
PORT=5000
NODE_ENV=development
ADMIN_API_KEY=change-this-secret-key

# Database (SQLite default — leave as is for local dev)
DATABASE_URL=./data/fetchly.db
# Uncomment for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/fetchly

# Redis (optional — app degrades gracefully without it)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Tools
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# CORS
CORS_ORIGIN=http://localhost:3000

# ==================== FRONTEND ====================
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME=FetchLy
